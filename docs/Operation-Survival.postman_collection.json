{
  "info": {
    "name": "Operation Survival API",
    "description": "Postman collection for Operation Survival backend APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "username",
      "value": "demoUser"
    },
    {
      "key": "password",
      "value": "123456"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "monsterId",
      "value": "1"
    },
    {
      "key": "itemCode",
      "value": "POTION"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Home",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Hello",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/hello"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Stage & Monster",
      "item": [
        {
          "name": "List Stages",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/stage/list"
          }
        },
        {
          "name": "Stage Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/stage/1"
          }
        },
        {
          "name": "Stage Monsters",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/monster/stage/1"
          }
        }
      ]
    },
    {
      "name": "Player",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/player/me"
          }
        },
        {
          "name": "Heal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/player/heal"
          }
        },
        {
          "name": "Advance Stage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/player/advance-stage"
          }
        },
        {
          "name": "Buy Potion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/player/buy-potion"
          }
        },
        {
          "name": "Use Potion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/player/use-potion"
          }
        },
        {
          "name": "Upgrade Skill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/player/upgrade-skill"
          }
        },
        {
          "name": "End Game",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/player/end-game"
          }
        }
      ]
    },
    {
      "name": "Weapon",
      "item": [
        {
          "name": "Get Weapon",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/weapon/me"
          }
        },
        {
          "name": "Upgrade Weapon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/weapon/upgrade"
          }
        }
      ]
    },
    {
      "name": "Battle",
      "item": [
        {
          "name": "Attack",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monsterId\": {{monsterId}},\n  \"useSkill\": false\n}"
            },
            "url": "{{baseUrl}}/api/battle/attack"
          }
        },
        {
          "name": "Skill Attack",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monsterId\": {{monsterId}},\n  \"useSkill\": true\n}"
            },
            "url": "{{baseUrl}}/api/battle/attack"
          }
        }
      ]
    },
    {
      "name": "Progress",
      "item": [
        {
          "name": "Get Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/progress"
          }
        },
        {
          "name": "Save Progress",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/progress/save"
          }
        }
      ]
    },
    {
      "name": "Shop",
      "item": [
        {
          "name": "List Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/shop/items"
          }
        },
        {
          "name": "Buy Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/shop/buy?itemCode={{itemCode}}"
          }
        }
      ]
    }
  ]
}